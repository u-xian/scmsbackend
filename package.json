{
  "name": "scmsbackend",
  "version": "1.0.0",
  "description": "A backend nodejs for the Scratch Cards Management System application",
  "main": "index.js",
  "scripts": {
    "start": "node ./bin/run.js",
    "dev": "nodemon ./bin/run.js",
    "create-admin": "node ./bin/create-admin.js",
    "test": "vitest --no-file-parallelism",
    "db:create": "sequelize-cli db:create",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:setup": "npm run db:create && npm run migrate && npm run seed",
    "seed": "sequelize-cli db:seed:all",
    "seed:undo": "sequelize-cli db:seed:undo:all",
    "db:drop": "sequelize-cli db:drop",
    "db:reset": "npm run db:drop && npm run db:setup"
  },
  "keywords": [],
  "author": "Christian Uwakristu",
  "license": "ISC",
  "dependencies": {
    "@hapi/joi-date": "^2.0.1",
    "axios": "^0.21.1",
    "bcrypt": "^6.0.0",
    "body-parser": "^1.19.0",
    "cors": "^2.8.5",
    "dateformat": "^4.4.1",
    "dotenv": "^8.2.0",
    "express": "^4.17.1",
    "joi": "^17.3.0",
    "jsonwebtoken": "^8.5.1",
    "lodash": "^4.17.20",
    "morgan": "^1.10.0",
    "njwt": "^1.0.0",
    "pg": "^8.5.1",
    "pg-hstore": "^2.3.3",
    "sequelize": "^6.3.5"
  },
  "devDependencies": {
    "nodemon": "^2.0.7",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "sequelize-cli": {
      "js-beautify": "^2.0.3"
    }
  }
}
